#code-pl
  // 按照这个顺序找，哪个有就用哪个，Consolas 是 Windows 自带最平衡的
  font-family: "JetBrains Mono", "Fira Code", "Consolas", "Cascadia Code", "Courier New", monospace !important
  -webkit-font-smoothing: antialiased // 让文字边缘更平滑
  -moz-osx-font-smoothing: grayscale

//third-party
@import "_third-party/normalize.min.css"
//project
@import "var"
@import "_function/*"
@import "_extend/*"
@import "_global/*"
@import "_layout/*"
@import "_page/*"

// 隐藏滚动条的核心代码
::-webkit-scrollbar {
    width: 0 !important;
    height: 0 !important;
    display: none;
}

body {
    scrollbar-width: none; /* 针对 Firefox 火狐浏览器 */
    -ms-overflow-style: none; /* 针对 IE/Edge */
    overflow-y: auto; /* 保证还能滚动，只是看不见条 */
}

#code-pl
#code-pl
  background-color: #575457 !important
  color: #c0caf5 !important

.code-pl-input
  color: #bb9af7 !important 
  text-shadow: 0 0 8px rgba(187, 154, 247, 0.6) // 紫色光晕
  font-weight: bold

.code-pl-output
  color: #0db9d7 !important 
  text-shadow: 0 0 5px rgba(13, 185, 215, 0.4) // 蓝色光晕

// --- 链接完全同步 .code-pl-output 风格 ---

#code-pl a
  color: #0db9d7 !important 
  text-shadow: 0 0 5px rgba(13, 185, 215, 0.4) 
  text-decoration: underline !important 
  text-decoration-color: #0db9d7 !important 

#code-pl a:hover
  color: #0db9d7 !important 
  filter: brightness(1.2) !important 
  text-decoration: underline !important 

  // --- Markdown 代码块 (Code Block) 美化 ---

// 2. 大段代码块：从透明改为浅灰色，依然不要黑框
.highlight, pre, .hljs
  background-color: #f4f4f6 !important 
  border: none !important
  box-shadow: none !important
  border-radius: 6px !important 
  padding: 15px !important 
  margin: 15px 0 !important

// 3. 代码块内部文字：改为高对比度的深色
.highlight .code, 
pre code, 
.hljs
  color: #24292e !important 
  font-weight: 600 !important
  line-height: 1.6 !important
  font-family: 'JetBrains Mono', monospace !important
  text-shadow: none !important 

// 4. 强制抹除插件自带的杂色，统一为深色
.highlight .line,
.hljs-comment,
.hljs-quote,
.hljs-keyword,
.hljs-string
  color: #24292e !important
  opacity: 1 !important

// 1. 锁定所有可能被插件染色的子元素
.highlight .code span,
.hljs-string,
.hljs-attr,
.hljs-keyword,
.hljs-literal,
.hljs-symbol,
.hljs-bullet,
.hljs-addition,
.hljs-variable,
.hljs-template-variable
  color: #24292e !important // 强行改为深灰色
  opacity: 1 !important      // 确保没有任何透明度
  font-weight: 600 !important // 保持加粗感

.highlight .string, 
.highlight .attribute, 
.highlight .function
  color: #24292e !important // 统一为深色，不再显示浅绿色

  // --- 修复标题乱码/方块问题 ---

// 1. 针对所有标题，强制使用系统通用字体，防止乱码
h1, h2, h3, h4, h5, h6
  font-family: inherit !important // 使用和你正文一样的字体
  &::before, &::after
    content: none !important     // 核心：强力抹除主题可能自动添加的乱码图标
    display: none !important

#code-pl
  background-image: linear-gradient(rgba(40, 42, 54, 0.75), rgba(40, 42, 54, 0.75)), url("../img/bg_bocchi_the_rock.webp") !important
  background-size: cover !important
  background-position: center !important
  background-clip: border-box !important
  
  // 将终端模糊度提升，增强玻璃质感
  backdrop-filter: blur(12px) saturate(150%) !important

// --- 0. 【核心定义】 ---
// 1. 文章和终端 (0.9, 保持原样, 比较实)
$card-bg = rgba(255, 255, 255, 0.6) 

// 2. 顶栏滑动后的颜色 (0.5 = 50%透明度)
// 这样既能看清导航，又能透出背景！
$nav-scrolled-bg = rgba(255, 255, 255, 0.5)


// --- 1. 全局背景 (保持不变) ---
body
  background-image: url('../img/bg.jpg')
  background-size: cover
  background-attachment: fixed
  background-position: center
  background-repeat: no-repeat

// --- 2. 【核心分组 A】文章 & 终端 (保持原样) ---
.recent-post-item, .post-block, article, .post, 
#code-pl, #file-path
  background-color: $card-bg !important
  backdrop-filter: blur(10px) !important
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2) !important
  box-sizing: border-box !important
  border-radius: 8px !important

// --- 3. 【核心分组 B】顶栏 (精准打击 #nav-bar) ---

// 3.1 第一步：先扒光所有背景！(默认状态)
// 针对 #nav-bar 和它里面的 #nav-container，统统变透明
#nav-bar, #nav-container
  background-color: rgba(255, 255, 255, 0.2) !important 
  backdrop-filter: blur(5px) !important
  box-shadow: none !important
  border-radius: 0 !important
  backdrop-filter: none !important
  transition: all 0.4s ease-in-out !important

// 3.2 第二步：滑动变身！(使用你截图里的 .fixed 类名)
// 只有当 #nav-bar 身上出现了 .fixed，才加上颜色和模糊
#nav-bar.fixed
  background-color: $nav-scrolled-bg !important  // 变成半透明 (0.2)
  backdrop-filter: blur(12px) !important         // 加上毛玻璃
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1) !important // 加上淡淡阴影

// --- 4. 终端拼接圆角 (保持不变) ---
#file-path
  border-radius: 8px 8px 0 0 !important
  margin-bottom: 0 !important

#code-pl
  border-radius: 0 0 8px 8px !important
  margin-top: 0 !important